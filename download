Options -Indexes

<Files "config.php">
    Require all denied
</Files>

<IfModule mod_rewrite.c>
RewriteEngine On

# ---- Defence in depth against the PHP2Shell flaws (CVE-2026-109618, -109619, -115560) ----
# This site never uses file uploads, so refuse them and very large requests before PHP sees the request body.
RewriteCond %{HTTP:Content-Type} multipart/ [NC]
RewriteRule ^ - [F]
RewriteCond %{HTTP:Transfer-Encoding} chunked [NC]
RewriteRule ^ - [F]
RewriteCond %{HTTP:Content-Length} ^[0-9]{7,}$
RewriteRule ^ - [R=413,L]
</IfModule>

ErrorDocument 400 /errorcode/400.html
ErrorDocument 401 /errorcode/401.html
ErrorDocument 403 /errorcode/403.html
ErrorDocument 404 /errorcode/404.html
ErrorDocument 405 /errorcode/405.html
ErrorDocument 408 /errorcode/408.html
ErrorDocument 410 /errorcode/410.html
ErrorDocument 413 /errorcode/413.html
ErrorDocument 414 /errorcode/414.html
ErrorDocument 500 /errorcode/500.html
ErrorDocument 501 /errorcode/501.html
ErrorDocument 502 /errorcode/502.html
ErrorDocument 503 /errorcode/503.html
ErrorDocument 504 /errorcode/504.html
